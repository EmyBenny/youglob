rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'uzorbenny51@gmail.com'
      );
    }

    // Validation Blueprints
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.grantedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'wishlist', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'wishlist', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 150
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.role in ['customer', 'admin']
        && data.wishlist is list && data.wishlist.size() <= 50
        && (data.wishlist.size() == 0 || (data.wishlist[0] is string && data.wishlist[0].size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'title', 'subtitle', 'category', 'price', 'stock', 'lowStockThreshold',
          'description', 'fabricSpecs', 'colors', 'sizes', 'styles', 'imageUrl',
          'galleryImages', 'featured', 'badge', 'rating', 'reviewCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'subtitle', 'category', 'price', 'stock', 'lowStockThreshold',
          'description', 'fabricSpecs', 'colors', 'sizes', 'styles', 'imageUrl',
          'galleryImages', 'featured', 'badge', 'rating', 'reviewCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 80
        && data.subtitle is string && data.subtitle.size() >= 1 && data.subtitle.size() <= 120
        && data.category in ['Laptops', 'Desktops', 'Monitors', 'Keyboards & Mice', 'Docks & Hubs', 'Storage & RAM', 'Audio & Webcams']
        && data.price is number && data.price > 0 && data.price <= 50000000
        && data.stock is number && data.stock >= 0 && data.stock <= 100000
        && data.lowStockThreshold is number && data.lowStockThreshold >= 0 && data.lowStockThreshold <= 1000
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 1200
        && data.fabricSpecs is string && data.fabricSpecs.size() <= 300
        && data.colors is list && data.colors.size() >= 1 && data.colors.size() <= 8
        && data.colors[0] is string && data.colors[0].size() <= 40
        && data.sizes is list && data.sizes.size() >= 1 && data.sizes.size() <= 8
        && data.sizes[0] is string && data.sizes[0].size() <= 16
        && data.styles is list && data.styles.size() >= 1 && data.styles.size() <= 8
        && data.styles[0] is string && data.styles[0].size() <= 40
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 500
        && data.galleryImages is list && data.galleryImages.size() <= 6
        && (data.galleryImages.size() == 0 || (data.galleryImages[0] is string && data.galleryImages[0].size() <= 500))
        && data.featured is bool
        && data.badge is string && data.badge.size() <= 40
        && data.rating is number && data.rating >= 0 && data.rating <= 5
        && data.reviewCount is number && data.reviewCount >= 0 && data.reviewCount <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'orderNumber', 'userId', 'customerEmail', 'customerName', 'items',
          'subtotal', 'shipping', 'total', 'status', 'paymentIntentId',
          'paymentMethod', 'paymentLast4', 'shippingAddress', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orderNumber', 'userId', 'customerEmail', 'customerName', 'items',
          'subtotal', 'shipping', 'total', 'status', 'paymentIntentId',
          'paymentMethod', 'paymentLast4', 'shippingAddress', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32
        && isValidId(data.userId)
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 150
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 30
        && data.items[0] is map
        && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 500000000
        && data.shipping is number && data.shipping >= 0 && data.shipping <= 500000
        && data.total is number && data.total >= 0 && data.total <= 500500000
        && data.status in ['paid', 'processing', 'shipped', 'delivered', 'cancelled']
        && data.paymentIntentId is string && data.paymentIntentId.size() >= 4 && data.paymentIntentId.size() <= 128
        && data.paymentMethod is string && data.paymentMethod.size() >= 2 && data.paymentMethod.size() <= 40
        && data.paymentLast4 is string && data.paymentLast4.size() == 4
        && data.shippingAddress is string && data.shippingAddress.size() >= 5 && data.shippingAddress.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'userName', 'rating', 'comment', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'userId', 'userName', 'rating', 'comment', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.productId)
        && isValidId(data.userId)
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 2 && data.comment.size() <= 600
        && data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'targetUserId', 'type', 'title', 'message', 'orderId', 'readBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'targetUserId', 'type', 'title', 'message', 'orderId', 'readBy', 'createdAt'])
        && isValidId(data.id)
        && data.targetUserId is string && data.targetUserId.size() >= 1 && data.targetUserId.size() <= 128
        && data.type in ['order_update', 'promotion', 'low_stock']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 100
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 300
        && data.orderId is string && data.orderId.size() <= 64
        && data.readBy is list && data.readBy.size() <= 100
        && (data.readBy.size() == 0 || (data.readBy[0] is string && data.readBy[0].size() <= 128))
        && data.createdAt is timestamp;
    }

    // Collection Rules
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(adminId) && isValidAdminUser(incoming()) && isAdmin()
        && incoming().uid == adminId && incoming().grantedAt == request.time;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'customer'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'wishlist', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(productId) && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
            && incoming().stock < existing().stock
            && incoming().stock >= 0)
        );
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(orderId) && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().userId == request.auth.uid
        && incoming().status == 'paid'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(orderId) && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid
            && existing().status == 'paid'
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(orderId);
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isVerified() && isValidId(reviewId) && isValidReview(incoming())
        && incoming().id == reviewId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/products/$(incoming().productId));
      allow update: if false;
      allow delete: if isValidId(reviewId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (
        isAdmin() || existing().targetUserId == 'all' || (isSignedIn() && existing().targetUserId == request.auth.uid)
      );
      allow list: if isAdmin() || resource.data.targetUserId == 'all' || (isSignedIn() && resource.data.targetUserId in ['all', request.auth.uid]);
      allow create: if isVerified() && isValidId(notificationId) && isValidNotification(incoming())
        && incoming().id == notificationId
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          (incoming().targetUserId == request.auth.uid && incoming().type in ['order_update', 'low_stock'])
        );
      allow update: if isVerified() && isValidId(notificationId) && isValidNotification(incoming())
        && incoming().id == existing().id
        && incoming().targetUserId == existing().targetUserId
        && incoming().type == existing().type
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          ((existing().targetUserId == 'all' || existing().targetUserId == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['readBy']))
        );
      allow delete: if isAdmin() && isValidId(notificationId);
    }
  }
}
