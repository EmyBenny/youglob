{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized store administrator record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer account profile and preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["customer", "admin"]
        },
        "wishlist": {
          "type": "array",
          "description": "Bounded list of wishlisted product IDs (max 50)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "wishlist", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "YouGlob Technology laptop, desktop, monitor, and computer accessory item with real-time stock tracking.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["Laptops", "Desktops", "Monitors", "Keyboards & Mice", "Docks & Hubs", "Storage & RAM", "Audio & Webcams"]
        },
        "price": {
          "type": "number"
        },
        "stock": {
          "type": "number"
        },
        "lowStockThreshold": {
          "type": "number"
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1200
        },
        "fabricSpecs": {
          "type": "string",
          "maxLength": 300
        },
        "colors": {
          "type": "array"
        },
        "sizes": {
          "type": "array"
        },
        "styles": {
          "type": "array"
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500
        },
        "galleryImages": {
          "type": "array"
        },
        "featured": {
          "type": "boolean"
        },
        "badge": {
          "type": "string",
          "maxLength": 40
        },
        "rating": {
          "type": "number"
        },
        "reviewCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "subtitle",
        "category",
        "price",
        "stock",
        "lowStockThreshold",
        "description",
        "fabricSpecs",
        "colors",
        "sizes",
        "styles",
        "imageUrl",
        "galleryImages",
        "featured",
        "badge",
        "rating",
        "reviewCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase record with verified payment metadata and status lifecycle.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "maxLength": 32
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerEmail": {
          "type": "string",
          "maxLength": 150
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "items": {
          "type": "array"
        },
        "subtotal": {
          "type": "number"
        },
        "shipping": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["paid", "processing", "shipped", "delivered", "cancelled"]
        },
        "paymentIntentId": {
          "type": "string",
          "maxLength": 128
        },
        "paymentMethod": {
          "type": "string",
          "maxLength": 40
        },
        "paymentLast4": {
          "type": "string",
          "maxLength": 4
        },
        "shippingAddress": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "orderNumber",
        "userId",
        "customerEmail",
        "customerName",
        "items",
        "subtotal",
        "shipping",
        "total",
        "status",
        "paymentIntentId",
        "paymentMethod",
        "paymentLast4",
        "shippingAddress",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer product review.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string",
          "minLength": 2,
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "productId", "userId", "userName", "rating", "comment", "createdAt"]
    },
    "NotificationRecord": {
      "title": "NotificationRecord",
      "description": "Real-time order status updates, low stock alerts, and promotional push notifications.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetUserId": {
          "type": "string",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": ["order_update", "promotion", "low_stock"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "orderId": {
          "type": "string",
          "maxLength": 64
        },
        "readBy": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "targetUserId", "type", "title", "message", "orderId", "readBy", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role assignment documents."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile documents isolated per user."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Publicly browsable YouGlob Technology computing hardware catalog with live inventory counts."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer order records restricted to order owner or admin."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Product reviews linked to existing products."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationRecord" },
      "description": "Order update, low stock, and promotional notification feed."
    }
  }
}
